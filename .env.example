# Private client hub
# Use a long, unique code and a separate random signing secret in production.
CLIENT_HUB_ACCESS_CODE=replace-with-a-long-client-access-code
CLIENT_HUB_SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret

# Internal lead desk (never share this code with clients)
TRUSTNOVA_ADMIN_ACCESS_CODE=replace-with-a-separate-admin-code
TRUSTNOVA_ADMIN_SESSION_SECRET=replace-with-a-different-random-32-character-or-longer-secret
# Endpoint returning { leads: [{ id, name, email, phone, service, message, receivedAt }] }
TRUSTNOVA_LEADS_API_URL=
TRUSTNOVA_LEADS_API_TOKEN=

# Gmail API connection for approval-gated email sending
GMAIL_SENDER_EMAIL=info@trustnova.in
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# WhatsApp Cloud API connection. Template must be approved in Meta before first outreach.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
